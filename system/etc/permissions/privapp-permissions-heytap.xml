<!--
This XML file declares which signature|privileged permissions should be granted to privileged
applications that come with the platform
This file contains the customization of Android privapp-permission-platform.xml,we should
not add logic in privapp-permission-platform.xml directly.
-->

<permissions>
    <privapp-permissions package="com.heytap.wearable.logkit">
        <permission name="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.DUMP"/>
        <permission name="android.permission.PACKAGE_USAGE_STATS"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
        <permission name="android.permission.WRITE_SETTINGS"/>
        <permission name="android.permission.NETWORK_SETTINGS" />
    </privapp-permissions>
    <privapp-permissions package="com.heytap.wearable.powermanager">
        <permission name="android.permission.BATTERY_STATS"/>
        <permission name="android.permission.DUMP"/>
        <permission name="android.permission.WRITE_SETTINGS"/>
        <permission name="android.permission.ACCESS_DIAGNOSIS_SERVICE"/>
    </privapp-permissions>
    <privapp-permissions package="com.heytap.wearable.clock">
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND" />
        <permission name="heytap.permission.DCC_PROTECTED" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
    </privapp-permissions>
    <privapp-permissions package="com.oplus.stdid">
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    </privapp-permissions>
    <privapp-permissions package="com.heytap.wearable.sports">
        <permission name="android.permission.STOP_APP_SWITCHES"/>
        <permission name="heytap.permission.DCC_PROTECTED"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.START_ACTIVITIES_FROM_BACKGROUND"/>
        <permission name="android.permission.SUBSTITUTE_NOTIFICATION_APP_NAME"/>
    </privapp-permissions>
    <privapp-permissions package="com.oplus.wearable.media.sessions">
        <permission name="heytap.permission.DCC_PROTECTED"/>
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
    </privapp-permissions>
	<privapp-permissions package="com.heytap.wearable.offload">
        <permission name="android.permission.SET_TIME"/>
        <permission name="android.permission.SET_TIME_ZONE"/>
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE"/>
    </privapp-permissions>
	<privapp-permissions package="com.oplus.wearable.setupwizard">
        <permission name="android.permission.CRYPT_KEEPER"/>
    </privapp-permissions>
    <privapp-permissions package="com.oplus.wearable.sysui">
        <permission name="android.permission.DELETE_PACKAGES"/>
        <permission name="android.permission.MANAGE_PROFILE_AND_DEVICE_OWNERS"/>
    </privapp-permissions>
</permissions>
